    # ── Creación de campo con LED ─────────────────────────────────────────────
    def crear_campo_telemetria(self, parent, etiqueta, var_name, campo_key):
        """
        Crea una fila con:
          [ETIQUETA]  [VALOR]  [LED]  [TEXTO ESTADO]
        """
        frame = tk.Frame(parent, bg=self.color_panel)
        frame.pack(fill=tk.X, pady=7)

        # Etiqueta
        tk.Label(frame, text=etiqueta,
                 font=("Arial", 11, "bold"),
                 bg=self.color_panel, fg="#aaaaaa",
                 width=14, anchor="w").pack(side=tk.LEFT)

        # Valor numérico
        valor = tk.Label(frame, text="---",
                         font=("Arial", 11),
                         bg=self.color_acento, fg=self.color_activo,
                         width=16, anchor="e", padx=8)
        valor.pack(side=tk.LEFT, padx=(0, 6))
        setattr(self, var_name, valor)

        # LED
        led = FocoLED(frame, bg_color=self.color_panel)
        led.pack(side=tk.LEFT, padx=(0, 4))
        self._leds[campo_key] = led

        # Texto de estado debajo del LED
        estado_txt = tk.Label(frame, text="INACTIVO",
                              font=("Arial", 8, "bold"),
                              bg=self.color_panel, fg="#666666",
                              width=8, anchor="w")
        estado_txt.pack(side=tk.LEFT)
        setattr(self, f"_estado_txt_{campo_key}", estado_txt)

    # ── Actualización de LEDs ─────────────────────────────────────────────────
    def _set_led_estado(self, campo_key: str, state: str):
        """Actualiza el LED y el texto de estado de un campo."""
        if campo_key not in self._leds:
            return
        self._leds[campo_key].set_state(state)
        txt_widget = getattr(self, f"_estado_txt_{campo_key}", None)
        if txt_widget:
            config = {
                LED_OK:    ("ACTIVO",    "#00ff88"),
                LED_ERROR: ("SIN DATOS", "#ff3333"),
                LED_OFF:   ("INACTIVO",  "#666666"),
            }[state]
            txt_widget.config(text=config[0], fg=config[1])

    def _actualizar_leds(self):
        """Decide el estado de cada LED según si el sistema está activo o no."""
        campos = ["latitud", "longitud", "altitud", "hora_gps"]
        if not self.sistema_activo:
            for c in campos:
                self._set_led_estado(c, LED_OFF)
            return
        # En simulación todos los campos llegan siempre.
        # Cuando uses datos reales puedes verificar si el valor cambió entre ciclos.
        for c in campos:
            self._set_led_estado(c, LED_OK)

