# ── Estados del foco LED ──────────────────────────────────────────────────────
LED_OFF     = "off"      # Sistema apagado  → foco apagado (gris oscuro)
LED_OK      = "ok"       # Dato recibido    → verde brillante
LED_ERROR   = "error"    # Sin datos        → rojo brillante

# Paleta de colores por estado del LED
LED_COLORS = {
    LED_OFF:   {"center": "#333333", "ring": "#222222", "glow": "#1a1a2e"},
    LED_OK:    {"center": "#00ff88", "ring": "#00cc66", "glow": "#003322"},
    LED_ERROR: {"center": "#ff3333", "ring": "#cc0000", "glow": "#330000"},
}
# ─────────────────────────────────────────────────────────────────────────────


class FocoLED(tk.Canvas):
    """
    Widget Canvas que simula un foco LED de 3 capas:
      • Resplandor exterior (glow)
      • Anillo (ring)
      • Punto central brillante (center)
    """
    SIZE = 22  # diámetro total en píxeles

    def __init__(self, parent, bg_color, **kwargs):
        super().__init__(parent,
                         width=self.SIZE, height=self.SIZE,
                         bg=bg_color, highlightthickness=0,
                         **kwargs)
        self._state = LED_OFF
        self._anim_id = None
        self._pulse = 0          # fase de pulsación cuando está en OK
        self._draw()

    # ── API pública ──────────────────────────────────────────────────────────
    def set_state(self, state: str):
        if state == self._state:
            return
        self._state = state
        if self._anim_id:
            self.after_cancel(self._anim_id)
            self._anim_id = None
        self._pulse = 0
        if state == LED_OK:
            self._animate_pulse()
        else:
            self._draw()

    # ── Dibujo ───────────────────────────────────────────────────────────────
    def _draw(self, brightness=1.0):
        self.delete("all")
        c = LED_COLORS[self._state]
        cx = cy = self.SIZE / 2
        r = self.SIZE / 2

        # 1) Resplandor exterior
        self.create_oval(1, 1, self.SIZE - 1, self.SIZE - 1,
                         fill=c["glow"], outline="")

        # 2) Anillo
        ring_pad = r * 0.25
        self.create_oval(ring_pad, ring_pad,
                         self.SIZE - ring_pad, self.SIZE - ring_pad,
                         fill=c["ring"], outline="")

        # 3) Centro (con brillo modulado)
        center_pad = r * 0.55
        center_color = self._blend(c["center"], brightness)
        self.create_oval(center_pad, center_pad,
                         self.SIZE - center_pad, self.SIZE - center_pad,
                         fill=center_color, outline="")

        # 4) Reflejo blanco (siempre, para aspecto realista)
        if self._state != LED_OFF:
            hi_size = r * 0.28
            self.create_oval(cx - hi_size * 1.3, cy - hi_size * 1.5,
                             cx + hi_size * 0.3, cy + hi_size * 0.1,
                             fill="#ffffff", outline="")

    def _animate_pulse(self):
        """Pulsación suave cuando el LED está en OK."""
        self._pulse = (self._pulse + 0.15) % (2 * math.pi)
        brightness = 0.75 + 0.25 * math.sin(self._pulse)
        self._draw(brightness)
        self._anim_id = self.after(60, self._animate_pulse)

    @staticmethod
    def _blend(hex_color: str, brightness: float) -> str:
        """Oscurece un color hex según el factor brightness (0-1)."""
        hex_color = hex_color.lstrip("#")
        r = int(int(hex_color[0:2], 16) * brightness)
        g = int(int(hex_color[2:4], 16) * brightness)
        b = int(int(hex_color[4:6], 16) * brightness)
        return f"#{r:02x}{g:02x}{b:02x}"


